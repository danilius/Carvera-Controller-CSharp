{
  "$schema": "../schema/layout.schema.json",
  "name": "Desktop",
  "description": "Full desktop layout: preview and console on the left, machine controls in a scrolling column on the right.",
  "window": { "minWidth": 1000, "minHeight": 680 },

  "theme": {
    "accent": "#2563EB"
  },

  "styles": {
    "toolbar-button": { "padding": "6 12" },
    "run-button": { "fontWeight": "semibold", "imagePlacement": "top", "imageWidth": 34, "imageHeight": 34, "padding": "6 4", "cornerRadius": 10 },
    "section-button": { "padding": "5 10" },
    "readout": { "fontSize": 13 }
  },

  "regions": {
    "runControls": {
      "type": "panel",
      "title": "Run",
      "orientation": "horizontal",
      "spacing": 8,
      "children": [
        {
          "type": "button", "id": "hold", "class": "run-button", "text": "Hold",
          "command": "pauseResume", "tooltip": "Feed hold / resume (Esc holds)",
          "visuals": {
            "normal": { "image": "assets/hold.svg" },
            "pressed": { "image": "assets/hold-pressed.svg" },
            "disabled": { "image": "assets/disabled.svg" }
          },
          "conditions": [
            { "when": "machine.state == 'Hold' || machine.state == 'Pause'", "text": "Resume", "image": "assets/resume.svg", "background": "#F0FDF4", "borderColor": "#16A34A" }
          ]
        },
        {
          "type": "button", "id": "start", "class": "run-button", "text": "Start",
          "command": "cycleStart", "tooltip": "Cycle start",
          "visuals": { "normal": { "image": "assets/start.svg" }, "disabled": { "image": "assets/disabled.svg" } }
        },
        {
          "type": "button", "id": "stop", "class": "run-button", "text": "Stop",
          "command": "stop", "tooltip": "Abort the running job",
          "visuals": {
            "normal": { "image": "assets/stop.svg" },
            "pressed": { "image": "assets/stop-pressed.svg" },
            "disabled": { "image": "assets/disabled.svg" }
          }
        },
        {
          "type": "button", "id": "reset", "class": "run-button", "text": "Reset",
          "command": "reset", "tooltip": "Soft reset (Ctrl-X)",
          "visuals": { "normal": { "image": "assets/reset.svg" }, "disabled": { "image": "assets/disabled.svg" } }
        }
      ]
    },

    "dro": {
      "type": "panel",
      "title": "Position ({wcs.activeName})",
      "spacing": 6,
      "children": [
        { "type": "axisReadout", "axis": "X", "show": ["work", "machine"], "height": "auto", "class": "readout" },
        { "type": "axisReadout", "axis": "Y", "show": ["work", "machine"], "height": "auto", "class": "readout" },
        { "type": "axisReadout", "axis": "Z", "show": ["work", "machine"], "height": "auto", "class": "readout" },
        { "type": "axisReadout", "axis": "A", "show": ["work"], "height": "auto", "class": "readout", "visible": "machine.modelName == 'CA1'" }
      ]
    },

    "workOffsets": {
      "type": "panel",
      "title": "Work offsets",
      "spacing": 8,
      "children": [
        {
          "type": "stack", "orientation": "horizontal", "spacing": 6, "height": "auto",
          "children": [
            { "type": "button", "class": "section-button", "text": "Zero XY", "command": "setWorkZero", "args": { "axes": "XY" }, "visuals": { "normal": { "image": "builtin:target" } } },
            { "type": "button", "class": "section-button", "text": "Zero Z", "command": "setWorkZero", "args": { "axes": "Z" } },
            { "type": "button", "class": "section-button", "text": "Go to XY0", "command": "gotoWorkHome" }
          ]
        },
        { "type": "wcsSelector", "height": 32 },
        {
          "type": "stack", "orientation": "horizontal", "spacing": 6, "height": "auto",
          "children": [
            { "type": "button", "class": "section-button", "text": "Set position…", "command": "setWorkPositionPrompt", "tooltip": "Type in what the current position should read" },
            { "type": "button", "class": "section-button", "text": "Rotate…", "command": "setRotation", "tooltip": "Rotate the active work coordinate system" },
            { "type": "button", "class": "section-button", "text": "Clear rotation", "command": "clearRotation" },
            { "type": "button", "class": "section-button", "text": "Set origin…", "command": "setWorkOrigin", "tooltip": "Put the work origin at an offset from anchor 1, anchor 2, the rotation centre or where the machine is now" }
          ]
        }
      ]
    },

    "jog": {
      "type": "panel",
      "title": "Jog",
      "spacing": 8,
      "children": [
        { "type": "jogPad", "axes": ["X", "Y", "Z"], "diagonals": true, "height": 190 },
        { "type": "jogStep", "height": 30 },
        {
          "type": "stack", "orientation": "horizontal", "spacing": 6, "height": "auto",
          "children": [
            {
              "type": "toggle", "text": "Continuous", "bind": "jog.buttonMode == 'continuous'", "command": "setJogMode",
              "onArgs": { "mode": "continuous" }, "offArgs": { "mode": "step" },
              "tooltip": "Off: one jog step per click or key press. On: the machine keeps moving while the button or key is held."
            },
            { "type": "toggle", "text": "Keys", "bind": "jog.keyboard", "command": "setJogKeyboard", "tooltip": "Jog with Ctrl+arrows and Ctrl+PageUp/PageDown. They follow the Continuous setting." }
          ]
        },
        {
          "type": "choice", "height": 30, "bind": "jog.feed", "command": "setJogFeed",
          "options": [
            { "value": 500, "text": "500" }, { "value": 1500, "text": "1500" },
            { "value": 3000, "text": "3000" }, { "value": 6000, "text": "6000" }
          ]
        }
      ]
    },

    "overrides": {
      "type": "panel",
      "title": "Overrides",
      "spacing": 6,
      "children": [
        { "type": "override", "kind": "feed", "height": 32 },
        { "type": "override", "kind": "spindle", "height": 32 }
      ]
    },

    "machine": {
      "type": "panel",
      "title": "Machine",
      "spacing": 6,
      "children": [
        {
          "type": "grid", "columns": ["*", "*"], "rows": ["auto", "auto", "auto"], "spacing": 6, "height": "auto",
          "children": [
            {
              "type": "toggle", "row": 0, "column": 0, "text": "Light", "bind": "switch.light", "command": "setLight",
              "visuals": {
                "off": { "image": "assets/light-off.svg", "imageWidth": 22, "imageHeight": 22 },
                "on": { "image": "assets/light-on.svg", "imageWidth": 22, "imageHeight": 22, "background": "#FEFCE8", "foreground": "#854D0E", "borderColor": "#EAB308" }
              }
            },
            {
              "type": "toggle", "row": 0, "column": 1, "text": "Air", "bind": "switch.air", "command": "setAir",
              "visuals": {
                "off": { "image": "assets/air-off.svg", "imageWidth": 22, "imageHeight": 22 },
                "on": { "image": "assets/air-on.svg", "imageWidth": 22, "imageHeight": 22, "background": "#F0F9FF", "foreground": "#075985", "borderColor": "#0284C7" }
              }
            },
            { "type": "toggle", "row": 1, "column": 0, "text": "Vacuum", "bind": "switch.vacuum", "command": "setVacuum" },
            { "type": "toggle", "row": 1, "column": 1, "text": "Tool sensor", "bind": "switch.toolSensor", "command": "setToolSensorPower" },
            { "type": "button", "row": 2, "column": 0, "text": "Home", "command": "home", "confirm": "Home all axes now?", "visuals": { "normal": { "image": "builtin:home" } } },
            { "type": "button", "row": 2, "column": 1, "text": "Unlock", "command": "unlock", "visuals": { "normal": { "image": "builtin:unlock" } } }
          ]
        },
        {
          "type": "stack", "orientation": "horizontal", "spacing": 6, "height": "auto",
          "children": [
            { "type": "button", "text": "Clearance", "command": "gotoClearance" },
            { "type": "button", "text": "Safe Z", "command": "gotoSafeZ" },
            { "type": "button", "text": "Anchor 1", "command": "gotoAnchor1" }
          ]
        }
      ]
    },

    "currentTool": {
      "type": "panel",
      "title": "Current tool",
      "spacing": 4,
      "children": [
        {
          "type": "text", "text": "{tool.label}", "height": "auto", "style": { "fontSize": 22, "fontWeight": "semibold" },
          "tooltip": "The tool in the spindle"
        },
        { "type": "value", "label": "Length offset", "bind": "tool.offset", "format": "0.000", "unit": "mm", "height": "auto" },
        {
          "type": "text", "text": "", "height": "auto", "visible": "tool.target >= 0 && tool.target != tool.current",
          "style": { "foreground": "@warning" },
          "conditions": [ { "when": "tool.target >= 0 && tool.target != tool.current", "text": "Changing to {tool.targetLabel}" } ]
        },
        {
          "type": "text", "text": "{atc.label}", "height": "auto", "visible": "atc.state != 0",
          "style": { "foreground": "@warning" }
        }
      ]
    },

    "toolChange": {
      "type": "panel",
      "title": "Tool change",
      "spacing": 6,
      "children": [
        {
          "type": "grid", "columns": ["*", "*", "*"], "rows": ["auto", "auto", "auto"], "spacing": 6, "height": "auto",
          "children": [
            { "type": "button", "row": 0, "column": 0, "text": "T1", "command": "toolChange", "args": { "tool": 1 }, "tooltip": "Change to tool 1", "conditions": [ { "when": "tool.current == 1", "background": "@accentSoft", "borderColor": "@accent" } ] },
            { "type": "button", "row": 0, "column": 1, "text": "T2", "command": "toolChange", "args": { "tool": 2 }, "tooltip": "Change to tool 2", "conditions": [ { "when": "tool.current == 2", "background": "@accentSoft", "borderColor": "@accent" } ] },
            { "type": "button", "row": 0, "column": 2, "text": "T3", "command": "toolChange", "args": { "tool": 3 }, "tooltip": "Change to tool 3", "conditions": [ { "when": "tool.current == 3", "background": "@accentSoft", "borderColor": "@accent" } ] },
            { "type": "button", "row": 1, "column": 0, "text": "T4", "command": "toolChange", "args": { "tool": 4 }, "tooltip": "Change to tool 4", "conditions": [ { "when": "tool.current == 4", "background": "@accentSoft", "borderColor": "@accent" } ] },
            { "type": "button", "row": 1, "column": 1, "text": "T5", "command": "toolChange", "args": { "tool": 5 }, "tooltip": "Change to tool 5", "conditions": [ { "when": "tool.current == 5", "background": "@accentSoft", "borderColor": "@accent" } ] },
            { "type": "button", "row": 1, "column": 2, "text": "T6", "command": "toolChange", "args": { "tool": 6 }, "tooltip": "Change to tool 6", "conditions": [ { "when": "tool.current == 6", "background": "@accentSoft", "borderColor": "@accent" } ] },
            { "type": "button", "row": 2, "column": 0, "text": "Probe", "command": "toolChange", "args": { "tool": 0 }, "tooltip": "Change to the wireless probe" },
            { "type": "button", "row": 2, "column": 1, "text": "3D Probe", "command": "toolChange", "args": { "tool": 999990 }, "tooltip": "Change to the 3D probe" },
            { "type": "button", "row": 2, "column": 2, "text": "Other…", "command": "toolChoose", "tooltip": "Type a tool number" }
          ]
        },
        {
          "type": "grid", "columns": ["*", "*"], "rows": ["auto", "auto", "auto"], "spacing": 6, "height": "auto",
          "children": [
            { "type": "button", "row": 0, "column": 0, "text": "Drop tool", "command": "toolDrop", "tooltip": "Put the tool in the spindle back in the magazine" },
            { "type": "button", "row": 0, "column": 1, "text": "Calibrate", "command": "toolCalibrate", "tooltip": "Measure the tool length on the tool sensor" },
            { "type": "button", "row": 1, "column": 0, "text": "Clamp", "command": "toolClamp", "tooltip": "Close the collet" },
            { "type": "button", "row": 1, "column": 1, "text": "Release", "command": "toolUnclamp", "tooltip": "Open the collet" },
            { "type": "button", "row": 2, "column": 0, "columnSpan": 2, "text": "Set tool number…", "command": "toolSetNumber", "tooltip": "Tell the machine which tool is in the spindle, without moving" }
          ]
        }
      ]
    },

    "prepare": {
      "type": "panel",
      "title": "Prepare workpiece",
      "spacing": 6,
      "children": [
        {
          "type": "grid", "columns": ["*", "*"], "rows": ["auto", "auto", "auto", "auto", "auto"], "spacing": 6, "height": "auto",
          "children": [
            { "type": "button", "row": 3, "column": 0, "text": "Z probe", "command": "autoRun", "args": { "zProbe": true }, "enabled": "file.hasBounds", "tooltip": "Probe Z at the Z probe position below" },
            { "type": "button", "row": 3, "column": 1, "text": "Z probe position…", "command": "zProbeSetup", "tooltip": "Where the Z probe is: from the work or path origin" },
            { "type": "text", "row": 4, "column": 0, "columnSpan": 2, "text": "Z probe {zprobe.label}", "wrap": true, "height": "auto" },
            { "type": "button", "row": 0, "column": 0, "text": "Margin", "command": "autoRun", "args": { "margin": true }, "enabled": "file.hasBounds", "tooltip": "Trace the open program's outline" },
            { "type": "button", "row": 0, "column": 1, "text": "Auto-level", "command": "autoRun", "args": { "leveling": true, "pointsX": 3, "pointsY": 3, "height": 5 }, "enabled": "file.hasBounds", "tooltip": "Probe a 3 x 3 grid over the open program's area" },
            { "type": "button", "row": 1, "column": 0, "text": "Go to path origin", "command": "gotoPathOrigin", "tooltip": "Move to the lower-left corner of the open program" },
            { "type": "button", "row": 1, "column": 1, "text": "XYZ probe", "command": "xyzProbe", "tooltip": "Probe X, Y and Z of a workpiece at the current position" },
            { "type": "button", "row": 2, "column": 0, "text": "Clear auto-level", "command": "clearAutoLevel", "tooltip": "Forget the auto-level map" },
            { "type": "button", "row": 2, "column": 1, "text": "Pair probe", "command": "pairProbe", "tooltip": "Pair the wireless workpiece probe" }
          ]
        }
      ]
    },

    "readings": {
      "type": "panel",
      "title": "Readings",
      "spacing": 2,
      "children": [
        { "type": "value", "label": "Feed", "bind": "feed.current", "format": "0", "unit": "mm/min", "height": "auto" },
        { "type": "value", "label": "Spindle", "bind": "spindle.current", "format": "0", "unit": "rpm", "height": "auto" },
        { "type": "value", "label": "Spindle temp.", "bind": "spindle.temperature", "format": "0.0", "unit": "°C", "height": "auto" },
        { "type": "value", "label": "Tool", "bind": "tool.current", "format": "0", "height": "auto" },
        { "type": "value", "label": "Tool offset", "bind": "tool.offset", "format": "0.000", "unit": "mm", "height": "auto" },
        { "type": "indicator", "text": "Probe", "bind": "sensor.probe", "height": "auto" },
        { "type": "indicator", "text": "Cover open", "bind": "sensor.cover", "height": "auto" }
      ]
    }
  },

  "root": {
    "type": "stack",
    "padding": 10,
    "spacing": 10,
    "children": [
      {
        "type": "stack", "orientation": "horizontal", "height": 38, "spacing": 8,
        "children": [
          {
            "type": "machineStatus", "width": 130,
            "tooltip": "The machine's state. It reads 'Waiting' until the first status report arrives, and 'No response' if reports stop.",
            "conditions": [
              { "when": "connection.connected && machine.awaitingStatus", "text": "Waiting…" },
              { "when": "connection.connected && machine.stalled", "text": "No response", "background": "@warningSoft", "borderColor": "@warning" }
            ]
          },
          { "type": "connection", "width": "auto", "kinds": ["wifi", "usb", "simulator"] },
          {
            "type": "text", "text": "No file open", "margin": "8 0 0 0", "tooltip": "The G-code file that is open",
            "conditions": [ { "when": "file.lineCount > 0", "text": "{file.localName}" } ]
          },
          { "type": "toggle", "text": "Air", "bind": "switch.air", "command": "setAir", "width": 84, "tooltip": "Air blast on or off" },
          { "type": "toggle", "text": "Vacuum", "bind": "switch.vacuum", "command": "setVacuum", "width": 100, "tooltip": "Vacuum on or off" },
          { "type": "button", "class": "toolbar-button", "text": "Open file", "command": "openFile", "width": "auto", "visuals": { "normal": { "image": "builtin:folder" } } },
          {
            "type": "button", "class": "toolbar-button", "text": "Upload", "command": "uploadFile", "width": "auto",
            "tooltip": "Send the open G-code file to the machine. Press again while it is sending to cancel.",
            "visuals": { "normal": { "image": "builtin:upload" } },
            "conditions": [ { "when": "transfer.active", "text": "Cancel: {transfer.phase} {transfer.percent:0}%", "background": "@warningSoft", "borderColor": "@warning" } ]
          },
          {
            "type": "button", "class": "toolbar-button", "text": "Save as", "command": "saveFile", "width": "auto",
            "enabled": "file.lineCount > 0", "tooltip": "Save the G-code, including tool changes made in the operations list",
            "visuals": { "normal": { "image": "builtin:save" } },
            "conditions": [ { "when": "file.modified", "text": "Save changes", "background": "@warningSoft", "borderColor": "@warning" } ]
          }
        ]
      },
      {
        "type": "split",
        "orientation": "horizontal",
        "sizes": ["*", "400"],
        "children": [
          {
            "type": "stack", "spacing": 10, "margin": "0 6 0 0",
            "children": [
              {
                "type": "split", "orientation": "horizontal", "sizes": ["*", "310"],
                "children": [
                  {
                    "type": "tabs", "margin": "0 6 0 0",
                    "children": [
                      {
                        "type": "stack", "title": "3D view", "spacing": 6,
                        "children": [
                          { "type": "toolpath" },
                          { "type": "gcodeScrubber", "height": "auto" }
                        ]
                      },
                      { "type": "gcodeList", "title": "G-code {file.localName}" },
                      { "type": "probePanel", "title": "Probing" },
                      {
                        "type": "scroll", "title": "Ring gauge",
                        "child": {
                          "type": "stack", "spacing": 8, "margin": "0 10 0 0",
                          "children": [
                            { "type": "text", "text": "{probe.drift.title}", "height": "auto", "style": { "fontSize": 16, "fontWeight": "semibold" } },
                            { "type": "text", "text": "{probe.drift.text}", "wrap": true, "height": "auto" },
                            {
                              "type": "stack", "orientation": "horizontal", "spacing": 6, "height": "auto",
                              "children": [
                                { "type": "button", "text": "{probe.drift.primary}", "command": "ringGaugeProbe", "tooltip": "Probes the ring gauge (asks first)" },
                                { "type": "button", "text": "Back", "command": "ringGaugeBack", "enabled": "probe.drift.step > 0 && !probe.drift.running" },
                                { "type": "button", "text": "Restart", "command": "ringGaugeReset", "enabled": "!probe.drift.running" }
                              ]
                            },
                            { "type": "toggle", "text": "Include the probe tip diameter", "bind": "probe.drift.applyTip", "command": "ringGaugeApplyTip", "onArgs": { "value": true }, "offArgs": { "value": false }, "height": "auto" },
                            { "type": "toggle", "text": "Keep the correction for XY-zeroing probes", "bind": "probe.drift.persist", "command": "ringGaugePersist", "onArgs": { "value": true }, "offArgs": { "value": false }, "height": "auto" },
                            { "type": "text", "text": "{probe.drift.points}", "wrap": true, "height": "auto" },
                            { "type": "text", "text": "{probe.drift.result}", "wrap": true, "height": "auto" },
                            { "type": "text", "text": "{probe.drift.stored}", "height": "auto" }
                          ]
                        }
                      },
                      {
                        "type": "scroll", "title": "Diagnose",
                        "child": {
                          "type": "stack", "spacing": 10, "margin": "0 10 0 0",
                          "children": [
                            {
                              "type": "panel", "title": "Switches", "spacing": 4,
                              "children": [
                                { "type": "indicator", "text": "Spindle", "bind": "switch.spindle", "height": "auto" },
                                { "type": "indicator", "text": "Spindle fan", "bind": "switch.spindleFan", "height": "auto" },
                                { "type": "indicator", "text": "Laser", "bind": "switch.laser", "height": "auto" },
                                { "type": "indicator", "text": "Vacuum", "bind": "switch.vacuum", "height": "auto" },
                                { "type": "indicator", "text": "Light", "bind": "switch.light", "height": "auto" },
                                { "type": "indicator", "text": "Air", "bind": "switch.air", "height": "auto" },
                                { "type": "indicator", "text": "Tool sensor power", "bind": "switch.toolSensor", "height": "auto" },
                                { "type": "indicator", "text": "Workpiece probe charging", "bind": "switch.wpCharge", "height": "auto" },
                                { "type": "value", "label": "Spindle level", "bind": "level.spindle", "format": "0", "height": "auto" },
                                { "type": "value", "label": "Vacuum level", "bind": "level.vacuum", "format": "0", "height": "auto" },
                                { "type": "value", "label": "Laser level", "bind": "level.laser", "format": "0", "height": "auto" },
                                { "type": "value", "label": "Spindle fan level", "bind": "level.spindleFan", "format": "0", "height": "auto" }
                              ]
                            },
                            {
                              "type": "panel", "title": "Sensors", "spacing": 4,
                              "children": [
                                { "type": "indicator", "text": "X min limit", "bind": "sensor.xMin", "height": "auto" },
                                { "type": "indicator", "text": "X max limit", "bind": "sensor.xMax", "height": "auto" },
                                { "type": "indicator", "text": "Y min limit", "bind": "sensor.yMin", "height": "auto" },
                                { "type": "indicator", "text": "Y max limit", "bind": "sensor.yMax", "height": "auto" },
                                { "type": "indicator", "text": "Z max limit", "bind": "sensor.zMax", "height": "auto" },
                                { "type": "indicator", "text": "Cover open", "bind": "sensor.cover", "height": "auto" },
                                { "type": "indicator", "text": "Probe", "bind": "sensor.probe", "height": "auto" },
                                { "type": "indicator", "text": "Calibrate input", "bind": "sensor.calibrate", "height": "auto" },
                                { "type": "indicator", "text": "ATC home", "bind": "sensor.atcHome", "height": "auto" },
                                { "type": "indicator", "text": "Tool sensor", "bind": "sensor.toolSensor", "height": "auto" },
                                { "type": "indicator", "text": "Emergency stop", "bind": "sensor.estop", "height": "auto", "tooltip": "Lit while the emergency stop is pressed" }
                              ]
                            }
                          ]
                        }
                      },
                      {
                        "type": "stack", "title": "Machine files", "spacing": 6,
                        "children": [
                          {
                            "type": "stack", "orientation": "horizontal", "height": 34, "spacing": 6,
                            "children": [
                              { "type": "button", "class": "toolbar-button", "text": "Up", "command": "remoteUp", "width": "auto", "visuals": { "normal": { "image": "builtin:arrow-up" } } },
                              { "type": "button", "class": "toolbar-button", "text": "Refresh", "command": "remoteRefresh", "width": "auto", "visuals": { "normal": { "image": "builtin:reset" } } },
                              { "type": "button", "class": "toolbar-button", "text": "New folder", "command": "remoteMkdir", "width": "auto", "visuals": { "normal": { "image": "builtin:plus" } } },
                              { "type": "spacer" },
                              { "type": "button", "class": "toolbar-button", "text": "Upload here", "command": "remoteUpload", "width": "auto", "tooltip": "Send the open G-code file to this folder", "visuals": { "normal": { "image": "builtin:upload" } } }
                            ]
                          },
                          {
                            "type": "stack", "orientation": "horizontal", "height": 34, "spacing": 6,
                            "children": [
                              { "type": "button", "class": "toolbar-button", "text": "Run", "command": "remotePlay", "width": "auto", "tooltip": "Run the selected file on the machine", "visuals": { "normal": { "image": "builtin:play" } } },
                              { "type": "button", "class": "toolbar-button", "text": "View", "command": "remoteView", "width": "auto", "tooltip": "Show the selected file in the 3D view without keeping a copy", "visuals": { "normal": { "image": "builtin:target" } } },
                              { "type": "button", "class": "toolbar-button", "text": "Download", "command": "remoteDownload", "width": "auto", "tooltip": "Save the selected file to this computer", "visuals": { "normal": { "image": "builtin:download" } } },
                              { "type": "button", "class": "toolbar-button", "text": "Rename", "command": "remoteRename", "width": "auto" },
                              { "type": "button", "class": "toolbar-button", "text": "Delete", "command": "remoteDelete", "width": "auto", "visuals": { "normal": { "image": "builtin:close" } } }
                            ]
                          },
                          { "type": "remoteFiles" }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "stack", "spacing": 10, "margin": "6 0 0 0",
                    "children": [
                      { "type": "panel", "title": "Operations ({file.operationCount})", "children": [ { "type": "operationList" } ] },
                      { "type": "panel", "title": "Tools", "height": "38%", "children": [ { "type": "toolList" } ] }
                    ]
                  }
                ]
              },
              {
                "type": "progress", "height": 24, "visible": "job.playing",
                "text": "{job.percent:0}%  ·  line {job.lines}  ·  {job.seconds} s"
              },
              {
                "type": "progress", "height": 24, "visible": "transfer.active", "bind": "transfer.percent",
                "text": "{transfer.phase} {transfer.name}  ·  {transfer.percent:0}%"
              },
              {
                "type": "panel", "title": "Console", "height": 210, "spacing": 6,
                "children": [
                  { "type": "console" },
                  { "type": "mdi", "height": "auto" }
                ]
              }
            ]
          },
          {
            "type": "stack", "spacing": 10, "margin": "0 0 0 6",
            "children": [
              { "region": "runControls", "height": "auto" },
              {
                "type": "tabs",
                "children": [
                  {
                    "type": "scroll", "title": "Move",
                    "child": {
                      "type": "stack", "spacing": 10, "margin": "0 10 0 0",
                      "children": [ { "region": "dro" }, { "region": "jog" }, { "region": "workOffsets" } ]
                    }
                  },
                  {
                    "type": "scroll", "title": "Machine",
                    "child": {
                      "type": "stack", "spacing": 10, "margin": "0 10 0 0",
                      "children": [ { "region": "overrides" }, { "region": "machine" }, { "region": "readings" } ]
                    }
                  },
                  {
                    "type": "scroll", "title": "Tools",
                    "child": {
                      "type": "stack", "spacing": 10, "margin": "0 10 0 0",
                      "children": [ { "region": "currentTool" }, { "region": "toolChange" } ]
                    }
                  },
                  {
                    "type": "scroll", "title": "Prepare",
                    "child": {
                      "type": "stack", "spacing": 10, "margin": "0 10 0 0",
                      "children": [ { "region": "prepare" } ]
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },

  "shortcuts": [
    { "key": "Escape", "command": "feedHold" },
    { "key": "Ctrl+Space", "command": "pauseResume" },
    { "key": "Ctrl+Left", "command": "jogKey", "args": { "axis": "X-" }, "release": "jogKeyStop" },
    { "key": "Ctrl+Right", "command": "jogKey", "args": { "axis": "X+" }, "release": "jogKeyStop" },
    { "key": "Ctrl+Up", "command": "jogKey", "args": { "axis": "Y+" }, "release": "jogKeyStop" },
    { "key": "Ctrl+Down", "command": "jogKey", "args": { "axis": "Y-" }, "release": "jogKeyStop" },
    { "key": "Ctrl+PageUp", "command": "jogKey", "args": { "axis": "Z+" }, "release": "jogKeyStop" },
    { "key": "Ctrl+PageDown", "command": "jogKey", "args": { "axis": "Z-" }, "release": "jogKeyStop" },
    { "key": "Ctrl+O", "command": "openFile" }
  ]
}
